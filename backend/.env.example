DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=society_residential
DB_PORT=3306
PORT=5000
FRONTEND_ORIGINS=http://localhost:5174
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Register AUTH_PUBLIC_URL/api/auth/google/callback as an authorized Google OAuth redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public backend origin used by provider callback URLs; frontend URL receives reset links.
AUTH_PUBLIC_URL=
FRONTEND_URL=
# SMTP credentials are used for one-time password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Configure Razorpay test/live keys in backend/.env. Never commit the secret key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
COMMUNITY_COUNTRY=IN
COMMUNITY_REGION=IN-MH
COMMUNITY_LOCATION=Pune, Maharashtra, India
